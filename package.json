{
	"name": "loopdelirium",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"convert-font": "tsx scripts/convert-font.ts",
		"publish": "vite build && gh-pages -d build -t"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-dsv": "^3.0.7",
		"@types/node": "^26.6.5",
		"@types/opentype.js": "^1.3.10",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"d3-dsv": "^3.0.1",
		"gh-pages": "^6.3.0",
		"marked": "^15.0.12",
		"mdsvex": "^0.11.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-qrcode": "^1.0.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"dependencies": {
		"opentype.js": "^2.0.0",
		"svelte-tweakpane-ui": "^1.6.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
